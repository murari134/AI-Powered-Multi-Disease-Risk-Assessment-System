# MediRisk 2.0 Backend Configuration

# API Settings
PROJECT_NAME="MediRisk 2.0 API"
API_V1_STR="/api/v1"
DEBUG=True

# Database Configuration (PostgreSQL 16)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/medirisk_db

# Cache & Rate Limiting (Redis 7)
REDIS_URL=redis://localhost:6379/0

# Authentication & Security
JWT_SECRET_KEY=change_this_to_a_secure_random_key_in_production_32_bytes_min
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Allowed Origins
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
